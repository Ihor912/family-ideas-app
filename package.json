{
  "name": "family-ideas-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/rules/**'",
    "test:watch": "vitest --exclude 'tests/rules/**'",
    "test:rules": "firebase emulators:exec --project demo-family-orbit --only firestore 'vitest run tests/rules'",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "validate:private": "node --import tsx scripts/validate-private.ts",
    "dev:demo": "VITE_DEMO_MODE=true vite --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@noble/hashes": "2.4.0",
    "firebase": "13.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
